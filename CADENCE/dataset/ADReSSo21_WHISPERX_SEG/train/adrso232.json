    {
      "speaker": "PAR",
      "start_ms": 537.0,
      "end_ms": 2960.0,
      "text": "I'd like for you to take a look at this picture."
    },
    {
      "speaker": "PAR",
      "start_ms": 4382.0,
      "end_ms": 7626.0,
      "text": "I'd like for you to tell me everything that you see happening in there."
    },
    {
      "speaker": "PAR",
      "start_ms": 8047.000000000001,
      "end_ms": 9929.0,
      "text": "Everything that's going on in that picture."
    },
    {
      "speaker": "PAR",
      "start_ms": 11932.0,
      "end_ms": 13554.0,
      "text": "Well, let's see. It looks like a woman. I"
    },
    {
      "speaker": "PAR",
      "start_ms": 15357.0,
      "end_ms": 17760.0,
      "text": "assume she's drying a dish."
    },
    {
      "speaker": "PAR",
      "start_ms": 21865.0,
      "end_ms": 27152.0,
      "text": "There's a window open in the kitchen. It is a kitchen."
    },
    {
      "speaker": "PAR",
      "start_ms": 28921.0,
      "end_ms": 31325.0,
      "text": "There is a child"
    },
    {
      "speaker": "PAR",
      "start_ms": 32046.0,
      "end_ms": 32888.0,
      "text": "reaching for a"
    },
    {
      "speaker": "PAR",
      "start_ms": 33769.0,
      "end_ms": 37416.0,
      "text": "cookie from the cookie jar. The"
    },
    {
      "speaker": "PAR",
      "start_ms": 39559.0,
      "end_ms": 41423.0,
      "text": "ladder that he's standing on is"
    },
    {
      "speaker": "PAR",
      "start_ms": 42044.0,
      "end_ms": 43045.0,
      "text": "beginning to fall."
    },
    {
      "speaker": "PAR",
      "start_ms": 46992.0,
      "end_ms": 47934.0,
      "text": "There's a little girl"
    },
    {
      "speaker": "PAR",
      "start_ms": 49356.0,
      "end_ms": 50338.0,
      "text": "in the house."
    },
    {
      "speaker": "PAR",
      "start_ms": 55077.0,
      "end_ms": 60183.0,
      "text": "Looks like mother has something fixed for dinner, I guess it is."
    },
    {
      "speaker": "PAR",
      "start_ms": 61625.0,
      "end_ms": 67412.0,
      "text": "Either that or the dishes she's dried, I'm not sure."
    },
    {
      "speaker": "PAR",
      "start_ms": 69174.0,
      "end_ms": 70596.0,
      "text": "There's water running over the"
    },
